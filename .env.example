# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Admin security
ADMIN_PIN="1234"
ADMIN_JWT_SECRET="change-me-super-secret"

# Google Business Profile OAuth (read-only review inbox)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://remixrequests.vercel.app/api/admin/google/callback"
# Generate once, store only in Vercel, and never rotate without reconnecting Google.
OAUTH_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Square Webhook
SQUARE_WEBHOOK_SIGNATURE_KEY="YOUR_SQUARE_SIGNATURE_KEY"

# Credit package mapping (example env keys)
CREDIT_PACK_5="10"
CREDIT_PACK_10="25"
CREDIT_PACK_15="35"
CREDIT_PACK_20="50"
